# ==============================================================================
# Poker Game Backend Environment Variables
# All variables are required in .env for fail-fast validation on startup.
# ==============================================================================

# --- SECURITY & JWT ---
# JWT Secret Key: Must be a Base64-encoded string representing at least 512 bits (64 bytes).
JWT_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# JWT Expiration in milliseconds (Default: 14400000 / 4 hours)
JWT_EXPIRATION_MILLIS=14400000

# --- SERVER & NETWORKING ---
# Server Port (Default: 8080)
SERVER_PORT=8080
# Comma-separated list of allowed origins for CORS.
# Include both ngrok domain suffixes if you tunnel the frontend for mobile testing:
# ngrok's randomly-generated tunnels use ngrok-free.app, while a free account's
# assigned static "dev domain" uses ngrok-free.dev.
# (Default: http://localhost:5173,https://*.ngrok-free.app,https://*.ngrok-free.dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://production-ui.com
# Set to true if running behind a reverse proxy (Nginx, Cloudflare) to resolve client IPs (Default: false)
TRUST_PROXY=false

# --- GAME TIMING & LIFECYCLE (in milliseconds) ---
# Per-player reconnection grace period window (Default: 120000 / 2 minutes)
POKER_DISCONNECT_GRACE_PERIOD_MS=120000
# Delay before ready gate opens after showdown reveal (Default: 0 / immediate)
POKER_ROUND_END_DISPLAY_DELAY_MS=0
# Shared ready countdown duration between hands (Default: 30000 / 30 seconds)
POKER_READY_COUNTDOWN_MS=30000
# Delay before finished room and game are destroyed (Default: 20000 / 20 seconds)
POKER_GAME_END_DISPLAY_DELAY_MS=20000

# --- RATE LIMITING ---
# Enable API and action rate limiting (Default: true)
POKER_RATE_LIMITING_ENABLED=true

# --- ENCRYPTED PERSISTENCE / WAL ---
# Enable encrypted per-room WAL recovery (Default: false)
POKER_PERSISTENCE_ENABLED=false
# Directory for WAL persistence storage (Default: ./data/poker-wal)
POKER_PERSISTENCE_DIRECTORY=./data/poker-wal
# Active key ID for writing WAL records (Default: current)
POKER_PERSISTENCE_CURRENT_KEY_ID=current
# Base64-encoded 256-bit (32-byte) AES key (generate via: openssl rand -base64 32)
POKER_PERSISTENCE_KEY_CURRENT=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Records compaction threshold (Default: 1000)
POKER_PERSISTENCE_COMPACT_AFTER_RECORDS=1000
# Bytes compaction threshold (Default: 16777216 / 16MB)
POKER_PERSISTENCE_COMPACT_AFTER_BYTES=16777216
